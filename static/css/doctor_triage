/*
 * CardioXAI Doctor Triage
 * Standalone styles
 */

#doctor-triage-panel {
  display: none;
  margin-top: 20px;
  border: 1px solid var(--border, #2a4347);
  border-radius: 10px;
  overflow: hidden;
  background: var(--panel, #102326);
  color: var(--text, #e9f1ef);
}

#doctor-triage-panel .doctor-triage-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  border-bottom: 1px solid var(--border, #2a4347);
}

#doctor-triage-panel .doctor-triage-eyebrow {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: 0.14em;
  color: var(--text-dim, #8fa8a6);
  margin-bottom: 5px;
}

#doctor-triage-panel .doctor-triage-heading {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
}

#doctor-triage-panel .doctor-triage-status {
  flex-shrink: 0;
  padding: 8px 12px;
  border-radius: 999px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  border: 1px solid currentColor;
}

#doctor-triage-panel .doctor-triage-body {
  padding: 20px;
}

#doctor-triage-panel .doctor-triage-probability {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 18px;
  color: var(--text-dim, #8fa8a6);
  font-size: 13px;
}

#doctor-triage-panel .doctor-triage-probability strong {
  font-family: "IBM Plex Mono", monospace;
  font-size: 25px;
  color: var(--text, #e9f1ef);
}

#doctor-triage-panel .doctor-triage-scale {
  margin-bottom: 20px;
}

#doctor-triage-panel .doctor-triage-scale-track {
  position: relative;
  height: 8px;
  border-radius: 99px;
  background:
    linear-gradient(
      to right,
      #3fbfae 0%,
      #3fbfae 25%,
      #d8b24c 25%,
      #d8b24c 50%,
      #e88b4e 50%,
      #e88b4e 75%,
      #e8664e 75%,
      #e8664e 100%
    );
}

#doctor-triage-panel .doctor-triage-marker {
  position: absolute;
  top: -3px;
  width: 2px;
  height: 14px;
  background: rgba(255, 255, 255, 0.8);
  z-index: 2;
}

#doctor-triage-panel .marker-low {
  left: 25%;
}

#doctor-triage-panel .marker-borderline {
  left: 50%;
}

#doctor-triage-panel .marker-high {
  left: 75%;
}

#doctor-triage-panel .marker-critical {
  left: 100%;
}

#doctor-triage-panel #doctor-triage-scale-indicator {
  position: absolute;
  top: 50%;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: #ffffff;
  border: 3px solid #102326;
  box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.8);
  z-index: 3;
  transition: left 0.35s ease;
}

#doctor-triage-panel .doctor-triage-scale-labels {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 8px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  color: var(--text-dim, #8fa8a6);
}

#doctor-triage-panel .doctor-triage-message {
  padding: 15px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.035);
  border-left: 3px solid currentColor;
  margin-bottom: 12px;
}

#doctor-triage-panel .doctor-triage-message strong {
  display: block;
  font-size: 14px;
  margin-bottom: 6px;
}

#doctor-triage-panel .doctor-triage-message p {
  margin: 0;
  color: var(--text-dim, #b4c4c2);
  line-height: 1.6;
  font-size: 13px;
}

#doctor-triage-panel .doctor-triage-action {
  padding: 14px 15px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.025);
  margin-bottom: 14px;
}

#doctor-triage-panel .doctor-triage-action-label {
  display: block;
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim, #8fa8a6);
  margin-bottom: 5px;
}

#doctor-triage-panel .doctor-triage-action p {
  margin: 0;
  font-size: 13px;
  line-height: 1.55;
}

#doctor-triage-panel .doctor-triage-disclaimer {
  padding-top: 12px;
  border-top: 1px solid var(--border, #2a4347);
  color: var(--text-dim, #8fa8a6);
  font-size: 10px;
  line-height: 1.55;
}

#doctor-triage-panel.doctor-triage-low {
  border-color: #3fbfae;
}

#doctor-triage-panel.doctor-triage-low
.doctor-triage-status {
  color: #3fbfae;
}

#doctor-triage-panel.doctor-triage-low
.doctor-triage-message {
  color: #3fbfae;
}

#doctor-triage-panel.doctor-triage-borderline {
  border-color: #d8b24c;
}

#doctor-triage-panel.doctor-triage-borderline
.doctor-triage-status {
  color: #d8b24c;
}

#doctor-triage-panel.doctor-triage-borderline
.doctor-triage-message {
  color: #d8b24c;
}

#doctor-triage-panel.doctor-triage-high {
  border-color: #e88b4e;
}

#doctor-triage-panel.doctor-triage-high
.doctor-triage-status {
  color: #e88b4e;
}

#doctor-triage-panel.doctor-triage-high
.doctor-triage-message {
  color: #e88b4e;
}

#doctor-triage-panel.doctor-triage-critical {
  border-color: #e8664e;
}

#doctor-triage-panel.doctor-triage-critical
.doctor-triage-status {
  color: #e8664e;
  animation: doctorTriagePulse 1.8s ease-in-out infinite;
}

#doctor-triage-panel.doctor-triage-critical
.doctor-triage-message {
  color: #e8664e;
}

#doctor-triage-panel.doctor-triage-critical
.doctor-triage-action {
  border-left: 3px solid #e8664e;
}

@keyframes doctorTriagePulse {
  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.65;
  }
}

@media (max-width: 600px) {
  #doctor-triage-panel .doctor-triage-header {
    align-items: flex-start;
    flex-direction: column;
  }

  #doctor-triage-panel .doctor-triage-status {
    width: 100%;
    text-align: center;
  }

  #doctor-triage-panel .doctor-triage-scale-labels {
    font-size: 8px;
  }

  #doctor-triage-panel .doctor-triage-probability strong {
    font-size: 21px;
  }
}

@media (prefers-reduced-motion: reduce) {
  #doctor-triage-panel #doctor-triage-scale-indicator {
    transition: none;
  }

  #doctor-triage-panel.doctor-triage-critical
  .doctor-triage-status {
    animation: none;
  }
}
